# .env de exemplo

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
POSTGRES_USER=ironforgeadmin
POSTGRES_PASSWORD=ironforge123
POSTGRES_HOST=ironforge-postgres
POSTGRES_PORT=5432

# ==========================================
# BROKER (Apache Kafka)
# ==========================================
KAFKA_BOOTSTRAP_SERVERS=ironforge-kafka:9092

# ==========================================
# SECURITY (Keycloak)
# ==========================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://ironforge-keycloak:8080
KEYCLOAK_REALM=ironforge-realm
KEYCLOAK_PEDIDOS_CLIENT_ID=ironforge-pedidos-service
KEYCLOAK_PEDIDOS_CLIENT_SECRET=ironforge-pedidos-secret-2026

# ==========================================
# STORAGE (MinIO S3)
# ==========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_URL=http://ironforge-minio:9000
MINIO_BUCKET_FATURAS=ironforge-faturas

# ==========================================
# SEGURANÇA INTERNA / WEBHOOKS
# ==========================================
WEBHOOK_API_KEY=ironforge-webhook-secret-key